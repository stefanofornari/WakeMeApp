<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ste.wakemeapp.settings.SettingsController"
      styleClass="settings-root" spacing="14" prefWidth="560">
    <padding>
        <Insets top="28" right="28" bottom="24" left="28"/>
    </padding>

    <Label text="Calendar" styleClass="settings-heading"/>
    <Label text="The link of a published calendar (ICS), the address of an Outlook calendar on Microsoft Graph, or the path of a CSV file."
           styleClass="settings-help" wrapText="true"/>

    <TextField fx:id="calendarField" styleClass="settings-field" promptText="https://…"/>

    <Label fx:id="kindLabel" styleClass="settings-kind" text=""/>
    <Label fx:id="hintLabel" styleClass="settings-help" wrapText="true" visible="false" managed="false"
           text="This calendar needs a Microsoft account: a client id and a tenant (--client-id, --tenant)."/>
    <Label fx:id="errorLabel" styleClass="settings-error" wrapText="true" visible="false" managed="false"/>

    <Label text="Notifications" styleClass="settings-heading"/>
    <CheckBox fx:id="notificationsCheck" text="Show meeting reminders" styleClass="settings-check"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Notify me" styleClass="settings-help"/>
        <ComboBox fx:id="leadTimeBox" styleClass="settings-choice" prefWidth="150" minWidth="150"/>
        <Label text="before a meeting starts" styleClass="settings-help"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Sound" styleClass="settings-help" minWidth="60"/>
        <ComboBox fx:id="soundBox" styleClass="settings-choice" prefWidth="200" minWidth="200"/>
        <Button fx:id="previewButton" text="Preview" minWidth="110" prefWidth="110" styleClass="settings-button" onAction="#handlePreview"/>
    </HBox>
    <Label fx:id="soundErrorLabel" styleClass="settings-error" wrapText="true" visible="false" managed="false"/>
    <Label fx:id="soundWarningLabel" styleClass="settings-warning" wrapText="true" visible="false" managed="false"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Volume" styleClass="settings-help" minWidth="60"/>
        <Slider fx:id="volumeSlider" min="0" max="100" value="80" majorTickUnit="25" minorTickCount="4"
                blockIncrement="5" prefWidth="260" styleClass="settings-slider"/>
        <Label fx:id="volumeLabel" text="80 %" styleClass="settings-help" minWidth="48"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="testButton" text="Test Notification" minWidth="190" prefWidth="190" styleClass="settings-button" onAction="#handleTestNotification"/>
        <Label text="Shows a test meeting like a real reminder, whatever the settings above." styleClass="settings-help" wrapText="true"/>
    </HBox>

    <Region VBox.vgrow="ALWAYS" minHeight="6"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton" text="Cancel" styleClass="settings-button" cancelButton="true" onAction="#handleCancel"/>
        <Button fx:id="saveButton" text="Save" styleClass="settings-button, settings-button-primary" defaultButton="true" onAction="#handleSave"/>
    </HBox>
</VBox>
